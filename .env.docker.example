# Used by docker compose (optional overrides). Copy to .env for local compose vars.
AUTH_SECRET=edc-docker-secret-change-me

# Production / VPS — set a strong password (used by docker-compose.prod.yml)
POSTGRES_PASSWORD=postgres

# Public site URL (used for logout redirects behind Nginx). Example:
# APP_URL=https://netmon.click
APP_URL=

# Optional SMTP / AI (leave empty for simulated / heuristic)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EDC Manager <noreply@edc.local>
AI_INSIGHTS_ENABLED=true
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Cron near-breach digest: POST /api/cron/near-breach-digest
CRON_SECRET=
