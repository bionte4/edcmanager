// EDC Vendor & SLA Management System
// Prisma schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum VendorType {
  DISTRIBUTOR
  FMS
}

enum EdcUnitStatus {
  BUFFER
  DEPLOYED
  IDLE
}

enum TicketLocation {
  DALAM_KOTA
  LUAR_KOTA
  LUAR_PULAU
}

enum TicketCategory {
  VIP
  NON_VIP
}

/// ITSM framework classification (Incident ≈ former CM tickets)
enum ItsmType {
  INCIDENT
  REQUEST
  PROBLEM
  CHANGE
}

/// Operational process detail under an ITSM type
enum OperationalProcess {
  CM
  PM
  INSTALL
  RELOCATE
  INVESTIGATION
  STANDARD_CHANGE
  NORMAL_CHANGE
  EMERGENCY_CHANGE
}

/// Full NOC ticketing lifecycle
enum TicketStatus {
  OPEN
  ACKNOWLEDGED
  DISPATCHED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SlaStatus {
  ON_TRACK
  WARNING
  ACHIEVED
  BREACHED
}

enum MutationType {
  DEPLOY
  RECALL
  TRANSFER
  POOLING
  BUFFER_TO_IDLE
  IDLE_TO_BUFFER
  STATUS_CHANGE
}

enum UserRole {
  ADMIN
  NOC
  SUPERVISOR
  VENDOR_TECH
  OPS_MANAGER
  GM
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
}

enum ShiftDutyStatus {
  SCHEDULED
  ON_DUTY
  OFF_DUTY
}

enum TicketActivityType {
  CREATED
  ACKNOWLEDGED
  ASSIGNED
  STATUS_CHANGED
  NOTE
  ESCALATED
  RESOLVED
  CLOSED
  HANDOVER
}

// ─── User (NOC / Supervisor / Tech) ──────────────────────────────────────────

/// Operations personnel who handle or supervise tickets.
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  role         UserRole
  /// Optional password hash for credential login (ADMIN manages users)
  passwordHash String?
  isActive     Boolean   @default(true)
  /// Soft delete — never hard-delete operational users
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shifts              NocShift[]
  ticketsAsNoc        Ticket[]         @relation("TicketNocOwner")
  ticketsCreated      Ticket[]         @relation("TicketCreatedBy")
  activitiesPerformed TicketActivity[]
  auditLogs           AuditLog[]

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

/// Named permission keys used by RBAC checks (seeded / managed by ADMIN).
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

/// Role ↔ permission mapping (ADMIN can adjust without redeploy).
model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

/// Immutable audit trail for admin / sensitive actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Standby / on-duty roster for NOC command center shifts.
model NocShift {
  id        String          @id @default(cuid())
  userId    String
  /// Calendar date of the shift (date-only)
  shiftDate DateTime        @db.Date
  shiftType ShiftType
  status    ShiftDutyStatus @default(SCHEDULED)
  startedAt DateTime?
  endedAt   DateTime?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, shiftDate, shiftType])
  @@index([shiftDate, status])
  @@index([status])
  @@map("noc_shifts")
}

// ─── Vendor ──────────────────────────────────────────────────────────────────

model Vendor {
  id              String     @id @default(cuid())
  name            String
  contactName     String
  contactEmail    String
  contactPhone    String
  type            VendorType
  allocationQuota Int
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  edcUnits   EdcUnit[]
  tickets    Ticket[]
  metricLogs MetricLog[]

  @@index([type])
  @@index([isActive])
  @@map("vendors")
}

// ─── EDC Unit ────────────────────────────────────────────────────────────────

model EdcUnit {
  id             String        @id @default(cuid())
  serialNumber   String        @unique
  brand          String
  regionalOffice String
  status         EdcUnitStatus @default(BUFFER)
  merchantId     String?
  vendorId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  vendor          Vendor               @relation(fields: [vendorId], references: [id])
  mutationHistory EdcMutationHistory[]
  tickets         Ticket[]

  @@index([vendorId])
  @@index([regionalOffice])
  @@index([status])
  @@index([regionalOffice, status])
  @@map("edc_units")
}

model EdcMutationHistory {
  id                 String         @id @default(cuid())
  edcUnitId          String
  mutationType       MutationType
  fromStatus         EdcUnitStatus?
  toStatus           EdcUnitStatus?
  fromRegionalOffice String?
  toRegionalOffice   String?
  notes              String?
  mutatedAt          DateTime       @default(now())
  mutatedBy          String?

  edcUnit EdcUnit @relation(fields: [edcUnitId], references: [id], onDelete: Cascade)

  @@index([edcUnitId])
  @@index([mutatedAt])
  @@map("edc_mutation_history")
}

// ─── Ticket (Corrective Maintenance) ─────────────────────────────────────────

model Ticket {
  id             String              @id @default(cuid())
  ticketNumber   String              @unique
  /// ITSM type — default INCIDENT (legacy CM corrective maintenance)
  itsmType       ItsmType            @default(INCIDENT)
  process        OperationalProcess  @default(CM)
  merchantId     String
  location       TicketLocation
  category       TicketCategory
  status         TicketStatus        @default(OPEN)
  slaStatus      SlaStatus           @default(ON_TRACK)
  openedAt       DateTime
  closedAt       DateTime?
  acknowledgedAt DateTime?
  dispatchedAt   DateTime?
  slaDeadlineAt  DateTime?
  description    String?
  technicianName String?
  /// External system ticket id for future integrations
  externalTicketId String?
  externalSystem   String?
  vendorId       String
  edcUnitId      String?
  nocOwnerId     String?
  createdById    String?
  /// Problem record that groups related incidents
  problemId      String?
  /// Optional linked change (fix / remediation)
  relatedChangeId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  vendor         Vendor            @relation(fields: [vendorId], references: [id])
  edcUnit        EdcUnit?          @relation(fields: [edcUnitId], references: [id])
  nocOwner       User?             @relation("TicketNocOwner", fields: [nocOwnerId], references: [id])
  createdBy      User?             @relation("TicketCreatedBy", fields: [createdById], references: [id])
  problem        Ticket?           @relation("IncidentToProblem", fields: [problemId], references: [id])
  relatedIncidents Ticket[]        @relation("IncidentToProblem")
  relatedChange  Ticket?           @relation("TicketToChange", fields: [relatedChangeId], references: [id])
  linkedFrom     Ticket[]          @relation("TicketToChange")
  activities     TicketActivity[]

  @@unique([externalSystem, externalTicketId])
  @@index([vendorId])
  @@index([edcUnitId])
  @@index([nocOwnerId])
  @@index([createdById])
  @@index([itsmType])
  @@index([process])
  @@index([problemId])
  @@index([relatedChangeId])
  @@index([location])
  @@index([category])
  @@index([slaStatus])
  @@index([status])
  @@index([openedAt])
  @@index([merchantId])
  @@map("tickets")
}

/// Immutable timeline of ticket actions (NOC / supervisor / tech).
model TicketActivity {
  id          String             @id @default(cuid())
  ticketId    String
  actorId     String?
  activityType TicketActivityType
  fromStatus  TicketStatus?
  toStatus    TicketStatus?
  note        String?
  createdAt   DateTime           @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
  @@index([activityType])
  @@map("ticket_activities")
}

// ─── Metric Log ──────────────────────────────────────────────────────────────

model MetricLog {
  id              String   @id @default(cuid())
  vendorId        String
  date            DateTime @db.Date
  uptimePercent   Decimal  @db.Decimal(5, 2)
  targetPercent   Decimal  @default(99.90) @db.Decimal(5, 2)
  metTarget       Boolean
  totalTickets    Int      @default(0)
  resolvedTickets Int      @default(0)
  breachedTickets Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, date])
  @@index([date])
  @@index([metTarget])
  @@map("metric_logs")
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SIMULATED
}

enum NotificationEvent {
  TICKET_ASSIGNED
  SLA_WARNING
  SLA_BREACHED
  BUFFER_ALERT
  DIGEST
  TEST
}

/// Outbound notification / email log
model NotificationLog {
  id        String              @id @default(cuid())
  event     NotificationEvent
  channel   NotificationChannel @default(EMAIL)
  status    NotificationStatus
  toAddress String
  subject   String
  body      String
  ticketId  String?
  error     String?
  createdAt DateTime            @default(now())

  @@index([event])
  @@index([status])
  @@index([createdAt])
  @@index([ticketId])
  @@map("notification_logs")
}

enum AiInsightKind {
  SUMMARY
  SLA_RISK
  SHIFT_BRIEFING
  VENDOR_COACHING
}

/// Cached AI / heuristic insights (advisory only — not SLA source of truth)
model AiInsight {
  id         String        @id @default(cuid())
  kind       AiInsightKind
  ticketId   String?
  title      String
  content    String
  riskScore  Int?
  provider   String        @default("heuristic")
  createdAt  DateTime      @default(now())

  @@index([kind])
  @@index([ticketId])
  @@index([createdAt])
  @@map("ai_insights")
}
