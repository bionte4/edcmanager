// EDC Vendor & SLA Management System
// Prisma schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum VendorType {
  DISTRIBUTOR
  FMS
}

enum EdcUnitStatus {
  BUFFER
  DEPLOYED
  IDLE
}

enum TicketLocation {
  DALAM_KOTA
  LUAR_KOTA
  LUAR_PULAU
}

/// ITSM framework classification (Incident ≈ former CM tickets)
enum ItsmType {
  INCIDENT
  REQUEST
  PROBLEM
  CHANGE
}

/// Operational process detail under an ITSM type
enum OperationalProcess {
  CM
  PM
  INSTALL
  RELOCATE
  INVESTIGATION
  STANDARD_CHANGE
  NORMAL_CHANGE
  EMERGENCY_CHANGE
}

/// Full NOC ticketing lifecycle
enum TicketStatus {
  OPEN
  ACKNOWLEDGED
  DISPATCHED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SlaStatus {
  ON_TRACK
  WARNING
  ACHIEVED
  BREACHED
}

enum SlaProfile {
  VIP
  NON_VIP
}

enum MutationType {
  DEPLOY
  RECALL
  TRANSFER
  POOLING
  BUFFER_TO_IDLE
  IDLE_TO_BUFFER
  STATUS_CHANGE
}

enum UserRole {
  ADMIN
  NOC
  SUPERVISOR
  VENDOR_TECH
  OPS_MANAGER
  GM
  LIAISON
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  /// Liaison LO — DOG day shift
  DAY_DOG
  /// Liaison LO — DOG night shift
  NIGHT_DOG
}

enum ShiftDutyStatus {
  SCHEDULED
  ON_DUTY
  OFF_DUTY
}

enum TicketActivityType {
  CREATED
  ACKNOWLEDGED
  ASSIGNED
  STATUS_CHANGED
  NOTE
  ESCALATED
  RESOLVED
  CLOSED
  HANDOVER
  CLOCK_STOPPED
  CLOCK_RESUMED
  CLOCK_STOP_REQUESTED
  CLOCK_STOP_APPROVED
  CLOCK_STOP_REJECTED
}

enum SlaPauseApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

// ─── User (NOC / Supervisor / Tech) ──────────────────────────────────────────

/// Operations personnel who handle or supervise tickets.
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  role         UserRole
  /// Optional password hash for credential login (ADMIN manages users)
  passwordHash String?
  isActive     Boolean   @default(true)
  /// Soft delete — never hard-delete operational users
  deletedAt    DateTime?
  /// JSON string array of home Regional Offices (dispatch coverage)
  homeRosJson  String    @default("[]")
  /// Field standby — scoring bonus for smart dispatch
  standbyField Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  shifts              NocShift[]
  ticketsAsNoc        Ticket[]         @relation("TicketNocOwner")
  ticketsCreated      Ticket[]         @relation("TicketCreatedBy")
  activitiesPerformed TicketActivity[]
  auditLogs           AuditLog[]
  slaPausesStarted    SlaPauseInterval[] @relation("SlaPauseStartedBy")
  slaPausesEnded      SlaPauseInterval[] @relation("SlaPauseEndedBy")
  slaPausesApproved   SlaPauseInterval[] @relation("SlaPauseApprovedBy")
  handoversFrom       HandoverLog[]      @relation("HandoverFrom")
  handoversTo         HandoverLog[]      @relation("HandoverTo")

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@index([standbyField])
  @@map("users")
}

/// Named permission keys used by RBAC checks (seeded / managed by ADMIN).
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

/// Role ↔ permission mapping (ADMIN can adjust without redeploy).
model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@map("role_permissions")
}

/// Immutable audit trail for admin / sensitive actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Standby / on-duty roster for NOC command center shifts.
model NocShift {
  id        String          @id @default(cuid())
  userId    String
  /// Calendar date of the shift (date-only)
  shiftDate DateTime        @db.Date
  shiftType ShiftType
  status    ShiftDutyStatus @default(SCHEDULED)
  startedAt DateTime?
  endedAt   DateTime?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, shiftDate, shiftType])
  @@index([shiftDate, status])
  @@index([status])
  @@map("noc_shifts")
}

/// Liaison LO shift handover (DOG day ↔ night).
model HandoverLog {
  id            String    @id @default(cuid())
  shiftDate     DateTime  @db.Date
  fromShiftType ShiftType
  toShiftType   ShiftType
  fromUserId    String
  toUserId      String?
  summary       String
  /// Ticket numbers highlighted in the handover brief
  openTickets   String[]  @default([])
  acknowledgedAt DateTime?
  createdAt     DateTime  @default(now())

  fromUser User  @relation("HandoverFrom", fields: [fromUserId], references: [id])
  toUser   User? @relation("HandoverTo", fields: [toUserId], references: [id])

  @@index([shiftDate])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
  @@map("handover_logs")
}

// ─── Vendor ──────────────────────────────────────────────────────────────────

model Vendor {
  id              String     @id @default(cuid())
  name            String
  contactName     String
  contactEmail    String
  contactPhone    String
  type            VendorType
  allocationQuota Int
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  edcUnits   EdcUnit[]
  tickets    Ticket[]
  metricLogs MetricLog[]

  @@index([type])
  @@index([isActive])
  @@map("vendors")
}

// ─── EDC Unit ────────────────────────────────────────────────────────────────

model EdcUnit {
  id             String        @id @default(cuid())
  serialNumber   String        @unique
  brand          String
  regionalOffice String
  status         EdcUnitStatus @default(BUFFER)
  merchantId     String?
  vendorId       String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  vendor          Vendor               @relation(fields: [vendorId], references: [id])
  mutationHistory EdcMutationHistory[]
  tickets         Ticket[]

  @@index([vendorId])
  @@index([regionalOffice])
  @@index([status])
  @@index([regionalOffice, status])
  @@map("edc_units")
}

model EdcMutationHistory {
  id                 String         @id @default(cuid())
  edcUnitId          String
  mutationType       MutationType
  fromStatus         EdcUnitStatus?
  toStatus           EdcUnitStatus?
  fromRegionalOffice String?
  toRegionalOffice   String?
  notes              String?
  mutatedAt          DateTime       @default(now())
  mutatedBy          String?

  edcUnit EdcUnit @relation(fields: [edcUnitId], references: [id], onDelete: Cascade)

  @@index([edcUnitId])
  @@index([mutatedAt])
  @@map("edc_mutation_history")
}

// ─── Ticket (Corrective Maintenance) ─────────────────────────────────────────

model Ticket {
  id             String              @id @default(cuid())
  ticketNumber   String              @unique
  /// ITSM type — default INCIDENT (legacy CM corrective maintenance)
  itsmType       ItsmType            @default(INCIDENT)
  process        OperationalProcess  @default(CM)
  merchantId     String
  /// Location code from LocationDef (maps to SLA zone Dalam/Luar kota/pulau)
  location       String
  /// Category code from TicketCategoryDef (VIP, NON_VIP, custom)
  category       String
  status         TicketStatus        @default(OPEN)
  slaStatus      SlaStatus           @default(ON_TRACK)
  openedAt       DateTime
  closedAt       DateTime?
  acknowledgedAt DateTime?
  dispatchedAt   DateTime?
  slaDeadlineAt  DateTime?
  description    String?
  technicianName String?
  /// External system ticket id for future integrations
  externalTicketId String?
  externalSystem   String?
  vendorId       String
  edcUnitId      String?
  nocOwnerId     String?
  createdById    String?
  /// Problem record that groups related incidents
  problemId      String?
  /// Optional linked change (fix / remediation)
  relatedChangeId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  vendor         Vendor            @relation(fields: [vendorId], references: [id])
  edcUnit        EdcUnit?          @relation(fields: [edcUnitId], references: [id])
  nocOwner       User?             @relation("TicketNocOwner", fields: [nocOwnerId], references: [id])
  createdBy      User?             @relation("TicketCreatedBy", fields: [createdById], references: [id])
  problem        Ticket?           @relation("IncidentToProblem", fields: [problemId], references: [id])
  relatedIncidents Ticket[]        @relation("IncidentToProblem")
  relatedChange  Ticket?           @relation("TicketToChange", fields: [relatedChangeId], references: [id])
  linkedFrom     Ticket[]          @relation("TicketToChange")
  activities     TicketActivity[]
  slaPauses      SlaPauseInterval[]

  @@unique([externalSystem, externalTicketId])
  @@index([vendorId])
  @@index([edcUnitId])
  @@index([nocOwnerId])
  @@index([createdById])
  @@index([itsmType])
  @@index([process])
  @@index([problemId])
  @@index([relatedChangeId])
  @@index([location])
  @@index([category])
  @@index([slaStatus])
  @@index([status])
  @@index([openedAt])
  @@index([merchantId])
  @@index([status, openedAt])
  @@index([slaStatus, status])
  @@index([slaDeadlineAt])
  @@map("tickets")
}

/// Immutable timeline of ticket actions (NOC / supervisor / tech).
model TicketActivity {
  id          String             @id @default(cuid())
  ticketId    String
  actorId     String?
  activityType TicketActivityType
  fromStatus  TicketStatus?
  toStatus    TicketStatus?
  note        String?
  createdAt   DateTime           @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
  @@index([activityType])
  @@map("ticket_activities")
}

/// Contractual SLA clock-stop windows (BRI-coordinated holds).
model SlaPauseInterval {
  id             String                 @id @default(cuid())
  ticketId       String
  reasonCode     String
  reasonNote     String?
  startedAt      DateTime               @default(now())
  endedAt        DateTime?
  startedById    String?
  endedById      String?
  approvalStatus SlaPauseApprovalStatus @default(NOT_REQUIRED)
  approvedById   String?
  approvedAt     DateTime?
  rejectionNote  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  startedBy  User?  @relation("SlaPauseStartedBy", fields: [startedById], references: [id])
  endedBy    User?  @relation("SlaPauseEndedBy", fields: [endedById], references: [id])
  approvedBy User?  @relation("SlaPauseApprovedBy", fields: [approvedById], references: [id])

  @@index([ticketId])
  @@index([ticketId, endedAt])
  @@index([ticketId, approvalStatus])
  @@index([startedAt])
  @@map("sla_pause_intervals")
}

// ─── Metric Log ──────────────────────────────────────────────────────────────

model MetricLog {
  id              String   @id @default(cuid())
  vendorId        String
  date            DateTime @db.Date
  uptimePercent   Decimal  @db.Decimal(5, 2)
  targetPercent   Decimal  @default(99.90) @db.Decimal(5, 2)
  metTarget       Boolean
  totalTickets    Int      @default(0)
  resolvedTickets Int      @default(0)
  breachedTickets Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, date])
  @@index([date])
  @@index([metTarget])
  @@map("metric_logs")
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SIMULATED
}

enum NotificationEvent {
  TICKET_ASSIGNED
  SLA_WARNING
  SLA_BREACHED
  BUFFER_ALERT
  DIGEST
  TEST
}

/// Outbound notification / email log
model NotificationLog {
  id        String              @id @default(cuid())
  event     NotificationEvent
  channel   NotificationChannel @default(EMAIL)
  status    NotificationStatus
  toAddress String
  subject   String
  body      String
  ticketId  String?
  error     String?
  createdAt DateTime            @default(now())

  @@index([event])
  @@index([status])
  @@index([createdAt])
  @@index([ticketId])
  @@map("notification_logs")
}

enum AiInsightKind {
  SUMMARY
  SLA_RISK
  SHIFT_BRIEFING
  VENDOR_COACHING
}

/// Cached AI / heuristic insights (advisory only — not SLA source of truth)
model AiInsight {
  id         String        @id @default(cuid())
  kind       AiInsightKind
  ticketId   String?
  title      String
  content    String
  riskScore  Int?
  provider   String        @default("heuristic")
  createdAt  DateTime      @default(now())

  @@index([kind])
  @@index([ticketId])
  @@index([createdAt])
  @@map("ai_insights")
}

// ─── Configurable ticket categories (VIP / NON_VIP / custom) ─────────────────

model TicketCategoryDef {
  id          String     @id @default(cuid())
  code        String     @unique
  label       String
  slaProfile  SlaProfile
  description String?
  sortOrder   Int        @default(100)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, sortOrder])
  @@map("ticket_categories")
}

/// Master lokasi operasional — kode di tiket memetakan ke zona SLA (TicketLocation).
model LocationDef {
  id                 String         @id @default(cuid())
  code               String         @unique
  label              String
  /// Zona matrix RESOLUTION_SLA_MINUTES
  slaZone            TicketLocation
  /// Opsional tautan ke RO inventori
  regionalOffice     String?
  description        String?
  sortOrder          Int            @default(100)
  isActive           Boolean        @default(true)
  /// false = alias zona (DALAM_KOTA/…) — tidak muncul di form tiket
  isTicketSelectable Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([slaZone])
  @@index([isActive, sortOrder])
  @@index([isTicketSelectable])
  @@map("locations")
}

// ─── OLA policies ────────────────────────────────────────────────────────────

enum OlaStage {
  ACKNOWLEDGE
  DISPATCH
}

model OlaPolicy {
  id                String   @id @default(cuid())
  name              String
  stage             OlaStage
  limitMinutes      Int
  warningThreshold  Float    @default(0.8)
  itsmType          String   @default("*")
  location          String   @default("*")
  category          String   @default("*")
  process           String   @default("*")
  priority          Int      @default(50)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([stage, isActive])
  @@index([priority])
  @@map("ola_policies")
}

// ─── WFM attendance & swap ───────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  LATE
  NO_ROSTER
  OUT_OF_WINDOW
}

enum AttendanceSource {
  LOGIN
  MANUAL
}

model AttendanceLog {
  id        String            @id @default(cuid())
  userId    String
  userName  String
  role      String
  shiftId   String?
  shiftDate DateTime          @db.Date
  shiftType ShiftType?
  status    AttendanceStatus
  loggedAt  DateTime          @default(now())
  source    AttendanceSource  @default(LOGIN)
  note      String?

  @@index([userId, shiftDate])
  @@index([shiftDate])
  @@index([loggedAt])
  @@map("attendance_logs")
}

enum SwapRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ShiftSwapRequest {
  id               String            @id @default(cuid())
  requesterId      String
  requesterName    String
  requesterShiftId String
  targetUserId     String
  targetUserName   String
  targetShiftId    String
  reason           String
  status           SwapRequestStatus @default(PENDING)
  createdAt        DateTime          @default(now())
  decidedAt        DateTime?
  decidedById      String?
  decidedByName    String?
  decisionNote     String?

  @@index([status])
  @@index([requesterId])
  @@index([targetUserId])
  @@map("shift_swap_requests")
}

// ─── Peripheral / consumable inventory ───────────────────────────────────────

enum PeripheralCategory {
  CABLE
  PAPER_ROLL
  SIM_CARD
  SPARE_PART
  OTHER
}

enum StockMutationType {
  IN
  OUT
  TRANSFER
  ADJUST
}

model PeripheralSku {
  id        String              @id @default(cuid())
  skuCode   String              @unique
  name      String
  category  PeripheralCategory
  unit      String
  minStock  Int                 @default(20)
  notes     String?
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  balances  PeripheralBalance[]
  mutations PeripheralMutation[]

  @@index([category, isActive])
  @@map("peripheral_skus")
}

model PeripheralBalance {
  id             String   @id @default(cuid())
  skuId          String
  regionalOffice String
  quantity       Int      @default(0)
  updatedAt      DateTime @updatedAt

  sku PeripheralSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, regionalOffice])
  @@index([regionalOffice])
  @@map("peripheral_balances")
}

model PeripheralMutation {
  id        String             @id @default(cuid())
  skuId     String
  type      StockMutationType
  quantity  Int
  fromRo    String?
  toRo      String?
  notes     String?
  mutatedAt DateTime           @default(now())
  mutatedBy String?

  sku PeripheralSku @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([skuId, mutatedAt])
  @@map("peripheral_mutations")
}

// ─── Integration API clients ─────────────────────────────────────────────────

model IntegrationClient {
  id         String   @id @default(cuid())
  name       String
  apiKey     String   @unique
  scopes     String   @default("tickets:read,tickets:write")
  externalSystem String @default("external")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@index([isActive])
  @@map("integration_clients")
}

/// Monitoring / diagnostic ingest log (webhook → optional auto Incident).
model IngestEvent {
  id              String   @id @default(cuid())
  sourceSystem    String
  externalEventId String
  payloadJson     String
  severityCode    String?
  serialNumber    String?
  merchantId      String?
  alertCode       String?
  matchedRule     String?
  outcome         String
  ticketId        String?
  ticketNumber    String?
  errorMessage    String?
  receivedAt      DateTime @default(now())

  @@unique([sourceSystem, externalEventId])
  @@index([receivedAt])
  @@index([outcome])
  @@index([serialNumber])
  @@map("ingest_events")
}

/// Batch log for monthly PM generation and peak intensification runs.
model PmCampaignRun {
  id          String   @id @default(cuid())
  kind        String
  periodKey   String
  status      String   @default("DONE")
  ticketCount Int      @default(0)
  metaJson    String?
  createdById String?
  generatedAt DateTime @default(now())

  @@unique([kind, periodKey])
  @@index([generatedAt])
  @@index([kind])
  @@map("pm_campaign_runs")
}

/// Peak season playbook windows (Natal / Tahun Baru / Lebaran) — editable via UI.
/// Multiple years allowed; unique on (kind, startDate).
model PeakSeasonWindow {
  id                  String   @id @default(cuid())
  /// NATAL | TAHUN_BARU | LEBARAN
  kind                String
  name                String
  /// Inclusive YYYY-MM-DD (Asia/Jakarta calendar)
  startDate           String
  endDate             String
  alertLeadDays       Int      @default(7)
  bufferFloorPercent  Int      @default(12)
  /// JSON string array of checklist items
  checklistJson       String   @default("[]")
  sortOrder           Int      @default(100)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([kind, startDate])
  @@index([isActive, startDate])
  @@index([kind])
  @@map("peak_season_windows")
}

/// Singleton PM monthly generator settings (edit via /ops/campaigns).
model PmSettings {
  id                        String   @id @default("default")
  /// Cron preferred day-of-month (Asia/Jakarta), 1–28 safe for all months
  generateDayOfMonth        Int      @default(1)
  warningDaysBeforeMonthEnd Int      @default(5)
  /// JSON string array of active Regional Offices; empty = all ROs
  activeRosJson             String   @default("[]")
  updatedAt                 DateTime @updatedAt

  @@map("pm_settings")
}
