# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edcmanager?schema=public"

# Signed session cookie secret (change in production)
AUTH_SECRET="edc-dev-secret-change-me"

# SMTP (optional — without these, emails are simulated to notification log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EDC Manager <noreply@edc.local>"
NOTIFY_SUPERVISOR_EMAIL=dewi.supervisor@edc.local
NOTIFY_OPS_EMAIL=rudi.ops@edc.local
NOTIFY_NOC_EMAIL=andi.noc@edc.local

# AI Insight (optional — heuristic works without key; set key to polish via LLM)
AI_INSIGHTS_ENABLED=true
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# Cron (near-breach 16:00 digest) — POST /api/cron/near-breach-digest
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
